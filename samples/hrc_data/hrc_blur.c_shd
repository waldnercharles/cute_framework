// 3x3 bilateral blur weighted by transmittance similarity.
//
// Removes checkerboard artifacts from the radiance cascade output.
// The checkerboard arises because v_n(k) has even y-offsets for n >= 1,
// so odd and even y-rows never interact during extend/merge.
//
// The blur is bilateral: neighbors whose transmittance differs significantly
// from the center pixel are downweighted, preventing light leaking through walls.
//
// Pipeline:  ... -> sum_quadrants -> blur -> composite
//                                   ^^^^

layout(set = 0, binding = 0) uniform sampler2D u_in_radiance;
layout(set = 0, binding = 1) uniform sampler2D u_transmittance;

layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D u_out;

layout(set = 2, binding = 0) uniform blur_params
{
	vec2 u_src_texel_size;
	float u_mip_level;
};

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Kernel weight: center=4, cardinal=2, diagonal=1.
// This is a 3x3 tent filter: K = 1/16 * [1 2 1; 2 4 2; 1 2 1].
float kernel_weight(int dx, int dy)
{
	int adx = abs(dx);
	int ady = abs(dy);
	if (adx == 0 && ady == 0) return 4.0;
	if (adx + ady == 1) return 2.0;
	return 1.0;
}

void main()
{
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(u_out);
	if (p.x >= size.x || p.y >= size.y) return;

	vec2 uv = (vec2(p) + vec2(0.5)) / vec2(size);
	vec3 center_t = texture(u_transmittance, uv).rgb;
	vec3 sum = vec3(0.0);
	float wsum = 0.0;

	for (int dy = -1; dy <= 1; ++dy) {
		for (int dx = -1; dx <= 1; ++dx) {
			vec2 uv_q = uv + vec2(float(dx), float(dy)) * u_src_texel_size;
			if (uv_q.x < 0.0 || uv_q.y < 0.0 || uv_q.x > 1.0 || uv_q.y > 1.0) continue;

			float wt = kernel_weight(dx, dy);

			// Edge weight: exponential falloff based on transmittance difference.
			// Neighbors with similar transmittance get full weight; neighbors
			// across an opacity boundary (wall edge) are suppressed.
			vec3 t = texture(u_transmittance, uv_q).rgb;
			vec3 diff = t - center_t;
			float edge_w = exp(-dot(diff, diff) * 16.0);

			sum += texture(u_in_radiance, uv_q).rgb * wt * edge_w;
			wsum += wt * edge_w;
		}
	}

	vec3 out_r = wsum > 0.0 ? sum / wsum : texture(u_in_radiance, uv).rgb;
	imageStore(u_out, p, vec4(out_r, 1.0));
}
