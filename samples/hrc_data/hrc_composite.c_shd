// Final composite: reads blurred/preblur radiance and writes sRGB output.
//
// Debug modes:
//   0: normal (blurred radiance, sRGB)
//   1-4: single quadrant from frustum SSBO
//   5: preblur (no blur, shows checkerboard artifacts)
//   6-7: handled in C by swapping the displayed canvas (emission/transmittance)
//
// Pipeline:  ... -> blur -> composite
//                           ^^^^^^^^^

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D u_radiance;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D u_preblur;
layout(std430, set = 0, binding = 2) readonly buffer F0 { uvec2 data[]; } u_f0;
layout(std430, set = 0, binding = 3) readonly buffer F1 { uvec2 data[]; } u_f1;
layout(std430, set = 0, binding = 4) readonly buffer F2 { uvec2 data[]; } u_f2;
layout(std430, set = 0, binding = 5) readonly buffer F3 { uvec2 data[]; } u_f3;

layout(set = 1, binding = 0, rgba8) uniform writeonly image2D u_fluence;

layout(set = 2, binding = 0) uniform Params
{
	int u_world_w;
	int u_world_h;
	int u_debug_mode;
};

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

vec4 f16_load(uvec2 packed)
{
	return vec4(unpackHalf2x16(packed.x), unpackHalf2x16(packed.y));
}

ivec2 world_to_rotated(ivec2 p, int rot, int w, int h)
{
	if (rot == 1) return ivec2(p.y, w - 1 - p.x);
	if (rot == 2) return ivec2(w - 1 - p.x, h - 1 - p.y);
	if (rot == 3) return ivec2(h - 1 - p.y, p.x);
	return p;
}

vec3 F_load(int rot, ivec2 rp)
{
	int rot_w = (rot == 0 || rot == 2) ? u_world_w : u_world_h;
	int rot_h = (rot == 0 || rot == 2) ? u_world_h : u_world_w;
	if (rp.x < 0 || rp.x >= rot_w || rp.y < 0 || rp.y >= rot_h) return vec3(0.0);
	int idx = rp.y * rot_w + rp.x;
	vec4 val;
	if      (rot == 0) val = f16_load(u_f0.data[idx]);
	else if (rot == 1) val = f16_load(u_f1.data[idx]);
	else if (rot == 2) val = f16_load(u_f2.data[idx]);
	else               val = f16_load(u_f3.data[idx]);
	return val.rgb;
}

void main()
{
	ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
	if (gid.x >= u_world_w || gid.y >= u_world_h) return;

	vec3 color;
	if (u_debug_mode >= 1 && u_debug_mode <= 4) {
		// Show a single quadrant without blur.
		int rot = u_debug_mode - 1;
		ivec2 rp = world_to_rotated(gid, rot, u_world_w, u_world_h) + ivec2(1, 0);
		color = F_load(rot, rp);
	} else if (u_debug_mode == 5) {
		// Preblur: show the raw sum_quadrants output before blur.
		color = imageLoad(u_preblur, gid).rgb;
	} else {
		// Normal: blurred radiance.
		color = imageLoad(u_radiance, gid).rgb;
	}

	// sRGB conversion.
	vec3 srgb = pow(max(color, vec3(0.0)), vec3(1.0 / 2.2));
	imageStore(u_fluence, gid, vec4(srgb, 1.0));
}
